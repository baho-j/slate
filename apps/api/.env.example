APP_NAME=Slate
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=slate
DB_USERNAME=slate
DB_PASSWORD=slate

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# CV uploads: local disk in dev, azure in prod (same Storage interface either way)
CV_DISK=local
# Org logos: local public disk in dev, azure (public-read container) in prod
LOGO_DISK=local
DB_QUEUE_TABLE=queue_jobs

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Dev: log (emails written to storage/logs) or smtp→Mailpit. Prod: acs (Azure Communication Services).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Azure Communication Services email (production mailer). Endpoint + key only; no secrets in the repo.
# From address must be on the linked ACS domain, e.g. donotreply@<subdomain>.azurecomm.net
ACS_EMAIL_ENDPOINT=
ACS_EMAIL_KEY=

AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=cvs
# Public-read container for org logos, and its public base URL
AZURE_LOGO_CONTAINER=logos
AZURE_LOGO_URL=

VITE_APP_NAME="${APP_NAME}"
