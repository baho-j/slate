  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "origin",
      "value": "http://localhost:5173"
    },
    {
      "key": "email",
      "value": "hr@slate.test"
    },
    {
      "key": "password",
      "value": "password"
    },
    {
      "key": "orgSlug",
      "value": "acme"
    }
  ],
