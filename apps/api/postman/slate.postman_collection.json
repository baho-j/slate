{
  "info": {
    "name": "Slate API",
    "description": "Contract tests mirroring docs/04. Grows with each new resource.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "origin",
      "value": "http://localhost:5173"
    },
    {
      "key": "email",
      "value": "hr@slate.test"
    },
    {
      "key": "password",
      "value": "password"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /api/health",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200))",
                  "pm.test('reports ok', () => pm.expect(pm.response.json().status).to.eql('ok'))"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "GET /api/auth/me (unauthenticated)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 without a session', () => pm.response.to.have.status(401))"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /sanctum/csrf-cookie",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Origin",
                "value": "{{origin}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/sanctum/csrf-cookie",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sanctum",
                "csrf-cookie"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('204', () => pm.response.to.have.status(204))",
                  "const jar = pm.cookies.jar()",
                  "jar.get(pm.variables.get('baseUrl'), 'XSRF-TOKEN', (err, value) => {",
                  "  pm.test('issues an XSRF cookie', () => pm.expect(value).to.be.a('string'))",
                  "  if (value) pm.collectionVariables.set('xsrf', decodeURIComponent(value))",
                  "})"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/auth/login (validation)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{origin}}"
              },
              {
                "key": "X-XSRF-TOKEN",
                "value": "{{xsrf}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('422 on missing fields', () => pm.response.to.have.status(422))",
                  "const body = pm.response.json()",
                  "pm.test('names the invalid fields', () => {",
                  "  pm.expect(body.errors).to.have.property('email')",
                  "  pm.expect(body.errors).to.have.property('password')",
                  "})"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/auth/login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{origin}}"
              },
              {
                "key": "X-XSRF-TOKEN",
                "value": "{{xsrf}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"{{email}}\",\"password\":\"{{password}}\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200))",
                  "const user = pm.response.json().data",
                  "pm.test('returns the user resource', () => {",
                  "  pm.expect(user.email).to.eql(pm.variables.get('email'))",
                  "  pm.expect(user).to.have.property('role')",
                  "})",
                  "pm.test('never leaks the password hash', () => pm.expect(user).to.not.have.property('password'))",
                  "const jar = pm.cookies.jar()",
                  "jar.get(pm.request.url.getHost(), 'XSRF-TOKEN', (err, value) => {",
                  "  if (value) pm.collectionVariables.set('xsrf', decodeURIComponent(value))",
                  "})"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/auth/me (authenticated)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{origin}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 with the session cookie', () => pm.response.to.have.status(200))",
                  "pm.test('is the logged-in user', () => pm.expect(pm.response.json().data.email).to.eql(pm.variables.get('email')))"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/auth/logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{origin}}"
              },
              {
                "key": "X-XSRF-TOKEN",
                "value": "{{xsrf}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "logout"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('204', () => pm.response.to.have.status(204))"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/auth/me (after logout)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{origin}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('session is gone', () => pm.response.to.have.status(401))"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
