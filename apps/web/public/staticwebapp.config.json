{
  "$schema": "https://json.schemastore.org/staticwebapp.config.json",
  "routes": [
    {
      "route": "/embed/*",
      "headers": {
        "Content-Security-Policy": "frame-ancestors *",
        "X-Frame-Options": ""
      }
    }
  ],
  "globalHeaders": {
    "Content-Security-Policy": "frame-ancestors 'none'",
    "X-Frame-Options": "DENY"
  },
  "navigationFallback": {
    "rewrite": "/index.html"
  }
}
